  CustomCSS.Strings = (
    
      '@import url('#39'https://fonts.googleapis.com/css2?family=Montserrat' +
      ':ital,wght@0,100..900;1,100..900&family=Titillium+Web:ital,wght@' +
      '0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,70' +
      '0&display=swap'#39');'
    ''
    '/* --- 1. SAF F1 KIRMIZISI RENK PALET'#304' --- */'
    ':root[data-theme="dark"] {'
    '  --bg-color: #0B0F14;'
    
      '  --primary-color: #E10600; /* Eski mavi yerine F1 K'#305'rm'#305'z'#305's'#305' gel' +
      'di */'
    '  --accent-color: #FF2B2B; '
    '  --warning-color: #FFD800; '
    '  --secondary-bg: #1A1D24;'
    '  --text-color: #E6EDF3;'
    
      '  --retro-shadow: #000; /* Blok yaz'#305'lar'#305'm'#305'z'#305'n g'#246'lgesi i'#231'in '#351'art!' +
      ' */'
    '}'
    ''
    ':root[data-theme="light"] {'
    '  --bg-color: #F0F4F8;'
    '  --primary-color: #D20000; '
    '  --accent-color: #FF1E1E;'
    '  --warning-color: #FFC107;'
    '  --secondary-bg: #FFFFFF;'
    '  --text-color: #1A202C;'
    '  --retro-shadow: rgba(0,0,0,0.5); '
    '}'
    ''
    '/* --- 2. F1 TEMALI SCROLLBAR --- */'
    '::-webkit-scrollbar {'
    '  width: 12px;'
    '}'
    '::-webkit-scrollbar-track {'
    '  background: var(--bg-color) !important; '
    '}'
    '::-webkit-scrollbar-thumb {'
    '  background: var(--primary-color) !important; '
    '  border-radius: 6px;'
    '  border: 3px solid var(--bg-color) !important;'
    '}'
    '::-webkit-scrollbar-thumb:hover {'
    '  background: var(--accent-color) !important; '
    '}'
    ''
    
      '/* --- 3. UNIGUI/EXTJS KISITLAMALARINI EZME VE SCROLL A'#199'MA --- *' +
      '/'
    
      '/* ExtJS'#39'in inline overflow: hidden de'#287'erlerini !important ile d' +
      'eliyoruz */'
    'html, body, .x-body, .x-viewport {'
    '  background-color: var(--bg-color) !important;'
    '  color: var(--text-color) !important;'
    
      '  font-family: '#39'Segoe UI'#39', Tahoma, Geneva, Verdana, sans-serif !' +
      'important;'
    '  margin: 0 !important;'
    '  padding: 0 !important;'
    '  overflow-x: hidden !important; '
    '  overflow-y: auto !important; /* S'#304'H'#304'RL'#304' DOKUNU'#350' BURASI */'
    '}'
    ''
    
      '/* UniGUI panellerinin arkaplanlar'#305'n'#305' ve s'#305'n'#305'r '#231'izgilerini '#351'effa' +
      'fla'#351't'#305'r'#305'yoruz */'
    '.x-panel, .x-panel-body, .x-window-body {'
    '  background-color: transparent !important;'
    '  background: transparent !important;'
    '  border: none !important;'
    '  box-shadow: none !important;'
    '  margin: 0 !important;'
    '  padding: 0 !important;'
    '}'
    '   '
    '.x-window, '
    '.x-window-default, '
    '.x-window-maximized,'
    '.x-layer {'
    '  border: none !important;'
    '  box-shadow: none !important;'
    '  outline: none !important;'
    '  background-color: var(--bg-color) !important;'
    '  background-image: none !important;'
    '}'
    ''
    '.swal2-container { '
    '  z-index: 2147483647 !important; '
    '}')
